[Unit]
Description=WiFi Manager - provisioning hotspot style IoT
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/
ExecStart=/opt/minitel-gpt/venv/bin/python -I /opt/minitel-gpt/current/root/wifi_manager.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
LogNamespace=minitel-gpt
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
