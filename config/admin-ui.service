[Unit]
Description=MinitelGPT Admin UI (port 8080)
After=network.target

[Service]
Type=simple
User=minitel
WorkingDirectory=/home/minitel/minitel-gpt
EnvironmentFile=-/home/minitel/minitel-gpt/.env
ExecStart=/opt/minitel-gpt/venv/bin/python /home/minitel/minitel-gpt/services/admin_ui.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LogNamespace=minitel-gpt
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
LimitCORE=0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
