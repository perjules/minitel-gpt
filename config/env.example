# Fournisseur d'IA : "mistral" (defaut), "claude" ou "linkup"
LLM_PROVIDER=mistral

# Mistral
MISTRAL_KEY=...
MISTRAL_MODEL=mistral-small-latest
# Reponses factuelles via Conversations, recherche hebergee automatique.
# Rollback explicite : chat_completions (aucune bascule automatique sur erreur).
MISTRAL_ANSWER_API=conversations
# 0 garde Conversations mais retire l'outil web_search.
MISTRAL_WEB_SEARCH=1
# Delai total local ; 60s provisoires, a mesurer sur le Pi.
MISTRAL_REQUEST_TIMEOUT=60

# Claude (Anthropic) - utilise si LLM_PROVIDER=claude
ANTHROPIC_KEY=...
CLAUDE_MODEL=claude-haiku-4-5

# Linkup (recherche web) - utilise si LLM_PROVIDER=linkup
# ATTENTION : Linkup n'est pas un generateur de texte mais un moteur de
# recherche web. Le prompt systeme (personnalite) et l'historique de
# conversation ne s'appliquent pas dans ce mode.
LINKUP_KEY=...
LINKUP_DEPTH=standard
