# Administration : valeur explicite obligatoire, vide = connexions refusees.
ADMIN_PASSWORD=

# Fournisseur d'IA : "mistral" (defaut), "claude" ou "linkup"
LLM_PROVIDER=mistral

# Memoire et journaux texte hors Git; defaut ~/.local/share/3615-ia.
# Optionnel; le dossier doit etre accessible au compte des deux services.
# MINITEL_MEMORY_DIR=/home/minitel/.local/share/3615-ia

# Mistral
MISTRAL_KEY=...
MISTRAL_MODEL=mistral-small-latest
# Gmail : vide = modèle général. Rédaction = nouveaux mails, réponses et révisions.
MISTRAL_GMAIL_MODEL=
MISTRAL_GMAIL_DRAFT_MODEL=
# Vide = défaut du fournisseur ; Small 4 / Medium 3.5 : none|high ; Large 4 : low|medium|high.
MISTRAL_GMAIL_DRAFT_REASONING_EFFORT=
# Reponses factuelles via Conversations, recherche hebergee automatique.
# Rollback explicite : chat_completions (aucune bascule automatique sur erreur).
MISTRAL_ANSWER_API=conversations
# 0 garde Conversations mais retire l'outil web_search.
MISTRAL_WEB_SEARCH=1
# Delai total local ; 60s provisoires, a mesurer sur le Pi.
MISTRAL_REQUEST_TIMEOUT=60

# 3615 rose: valeur fixe privée et littérale, sans accès mémorisé.
# Préférer scripts/rose_console.py --set-password (fichier ignoré par Git).
# ROSE_PASSWORD peut aussi être défini localement ; absent/vide = verrouillé.

# Claude (Anthropic) - utilise si LLM_PROVIDER=claude
ANTHROPIC_KEY=...
CLAUDE_MODEL=claude-haiku-4-5

# Linkup (recherche web) - utilise si LLM_PROVIDER=linkup
# ATTENTION : Linkup n'est pas un generateur de texte mais un moteur de
# recherche web. Le prompt systeme (personnalite) et l'historique de
# conversation ne s'appliquent pas dans ce mode.
LINKUP_KEY=...
LINKUP_DEPTH=standard
