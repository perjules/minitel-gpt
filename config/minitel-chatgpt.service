[Unit]
Description=MINITEL GPT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minitel
WorkingDirectory=/home/minitel/minitel-gpt
EnvironmentFile=-/home/minitel/minitel-gpt/.env
ExecStart=/opt/minitel-gpt/venv/bin/python /home/minitel/minitel-gpt/services/minitel_chatgpt.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LogNamespace=minitel-gpt
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
